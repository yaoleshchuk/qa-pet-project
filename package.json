{
  "name": "qa-pet-project",
  "version": "1.0.0",
  "description": "QA automation showcase: Cypress + Playwright + Gherkin BDD + GitHub Actions",
  "private": true,
  "scripts": {
    "mock:start": "node mock-server/server.js",
    "typecheck": "tsc --noEmit",
    "test:pw:dry-run": "node scripts/validate-cucumber-profile.js default",
    "test:pw:acceptance": "node scripts/validate-cucumber-profile.js acceptance",
    "test:pw:smoke": "node scripts/validate-cucumber-profile.js smoke",
    "test:pw:regression": "node scripts/validate-cucumber-profile.js regression",
    "test:api:all": "API_URL=http://localhost:3001 cucumber-js --profile api-all",
    "test:api:acceptance": "API_URL=http://localhost:3001 cucumber-js --profile api-acceptance",
    "test:api:smoke": "API_URL=http://localhost:3001 cucumber-js --profile api-smoke",
    "test:api:regression": "API_URL=http://localhost:3001 cucumber-js --profile api-regression",
    "test:cypress:open": "cypress open",
    "test:cypress:run": "cypress run",
    "test:cypress:acceptance": "cypress run --env tags=@Acceptance",
    "test:cypress:smoke": "cypress run --env tags=@Smoke",
    "test:cypress:regression": "cypress run --env tags=@Regression",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "ai:generate": "ts-node --project tsconfig.json scripts/ai-generate-feature.ts",
    "ai:generate:mock": "ts-node --project tsconfig.json scripts/ai-generate-feature.ts --mock"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@badeball/cypress-cucumber-preprocessor": "^20.1.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.1",
    "@cucumber/cucumber": "^10.8.0",
    "@playwright/test": "^1.44.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "allure-commandline": "^2.33.0",
    "allure-cucumberjs": "^3.0.4",
    "cypress": "^13.10.0",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
